# Copy this file to `.env.server` and fill in the values.
# `.env.server` is gitignored and must never be committed.

# Google Gemini API key — powers question generation, resume parsing,
# scoring, and audio transcription. Get one at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: log verbosity for the server (debug | info | warn | error).
# Defaults to "debug" in development and "info" in production.
# LOG_LEVEL=info

# DATABASE_URL is managed automatically by `wasp db start` in development.
# Set it explicitly only when pointing at an external Postgres instance.
# DATABASE_URL=postgresql://user:password@host:5432/talentscope
