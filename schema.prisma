datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Use Prisma Schema file to define your entities: https://www.prisma.io/docs/concepts/components/prisma-schema.
// Run `wasp db migrate-dev` in the CLI to create the database tables,
// then run `wasp db studio` to open Prisma Studio and view your db models.

// Note: Password is managed by Wasp's Auth system (not stored in User model)
model User {
  id       String @id @default(uuid())
  email    String @unique
  name     String
  phone    String?
  
  // Email verification tracking (managed by Wasp)
  isEmailVerified         Boolean   @default(false)
  emailVerificationSentAt DateTime?
  passwordResetSentAt     DateTime?
  
  createdAt DateTime @default(now())

  testResults       TestResult[]
  interviewSessions InterviewSession[]
}

// A live interview in progress. Persisted (rather than held in memory) so that
// sessions survive server restarts and work across multiple server instances.
model InterviewSession {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  profile              Json // CandidateProfile snapshot
  questions            Json // InterviewQuestion[]
  answers              Json   @default("[]") // AnswerRecord[]
  currentQuestionIndex Int    @default(0)
  status               String @default("active") // active | completed | abandoned
  mode                 String @default("text") // text | voice

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model TestResult {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Profile information
  profileName  String
  profileEmail String
  profilePhone String?
  skills       String[] // Array of skills

  // Interview data
  answers    Json // Store answers as JSON
  summary    String @db.Text
  totalScore Int // Score 0-100
  status     String // completed, interrupted, expired
  mode       String @default("text") // text | voice

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([totalScore])
}
